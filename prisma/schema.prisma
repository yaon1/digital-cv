generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  title       String
  description String
  links       Link[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
}

model Link {
  id        Int     @id @default(autoincrement())
  profileId Int
  label     String
  url       String
  position  Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        Int     @id @default(autoincrement())
  profileId Int
  name      String
  category  String
  position  Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id           Int           @id @default(autoincrement())
  profileId    Int
  company      String
  position     String
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  achievements Achievement[]
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Achievement {
  id           Int        @id @default(autoincrement())
  experienceId Int
  text         String
  position     Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Project {
  id           Int     @id @default(autoincrement())
  profileId    Int
  name         String
  url          String
  description  String
  technologies String[]
  position     Int     @default(0)
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
